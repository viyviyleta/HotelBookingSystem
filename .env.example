# ЛР №8. Скопируйте в .env и подставьте свои значения: cp .env.example .env
# Файл .env в репозиторий не попадает (.gitignore), пароль в Docker-образ не зашивается.

# Пароль суперпользователя PostgreSQL в контейнере db.
DB_PASSWORD=change-me

# Имя базы и пользователя внутри контейнера db.
DB_NAME=hotelbooking
DB_USER=postgres

# Порт PostgreSQL, опубликованный на хосте (5432 занят локальным PostgreSQL, 5433 - другим контейнером).
DB_HOST_PORT=5434

# Порт сервера: внутри контейнера и опубликованный на хосте.
SERVER_PORT=5377
SERVER_HOST_PORT=5377

# Параметры кластера узлов ЛР №7 и задержки ЛР №4.
CLUSTER_NODES=5
CLUSTER_PORT=5411
HEARTBEAT_TIMEOUT_MS=500
RESERVE_DELAY_MS=200

# Схемы Primary и Replica ЛР №5.
DB_PRIMARY_SCHEMA=riot_primary
DB_REPLICA_SCHEMA=riot_replica